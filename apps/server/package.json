{
  "name": "@sunshop/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sunshop API, Express + MongoDB + Redis + Elasticsearch",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --import ./esm-hook.mjs src/index.ts",
    "build": "tsup",
    "start": "node --import ./esm-hook.mjs dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed": "tsx src/scripts/seed.ts",
    "reindex": "tsx src/scripts/reindex.ts",
    "create-admin": "tsx src/scripts/createAdmin.ts",
    "openapi": "tsx src/scripts/exportOpenapi.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@aws-sdk/client-s3": "^3.712.0",
    "@aws-sdk/client-ses": "^3.712.0",
    "@aws-sdk/cloudfront-signer": "^3.709.0",
    "@aws-sdk/s3-presigned-post": "^3.712.0",
    "@aws-sdk/s3-request-presigner": "^3.712.0",
    "@elastic/elasticsearch": "^8.16.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-aws-sdk": "^0.76.0",
    "@opentelemetry/instrumentation-express": "^0.69.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-ioredis": "^0.69.0",
    "@opentelemetry/instrumentation-mongodb": "^0.74.0",
    "@opentelemetry/instrumentation-mongoose": "^0.67.0",
    "@opentelemetry/instrumentation-pino": "^0.67.0",
    "@opentelemetry/instrumentation-undici": "^0.31.0",
    "@opentelemetry/resource-detector-aws": "^2.21.0",
    "@opentelemetry/resource-detector-container": "^0.8.12",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@sunshop/shared": "*",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.2",
    "ms": "^2.1.3",
    "nanoid": "^5.0.9",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "otplib": "^12.0.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.13.1",
    "stripe": "^17.5.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/ms": "^0.7.34",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "@types/sanitize-html": "^2.13.0",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.11",
    "mongodb-memory-server": "^10.1.2",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist",
    "esm-hook.mjs"
  ]
}
