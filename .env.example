# ─────────────────────────────────────────────────────────────────────────────
# Sunshop: root environment template.
# Copy to `.env` for local development:  cp .env.example .env
# In AWS, every value marked [SECRET] comes from AWS Secrets Manager via the
# External Secrets Operator (see infra/k8s/base/external-secrets.yaml).
# NEVER commit a real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_NAME=Sunshop
LOG_LEVEL=debug
# Comma-separated. Must be exact origins in production (no wildcards).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_ADMIN_URL=http://localhost:5174
PUBLIC_API_URL=http://localhost:4000
# Number of reverse proxies in front of the API (ALB + ingress = 2).
TRUST_PROXY_HOPS=1

# ── MongoDB (Amazon DocumentDB in prod) ─────────────────────────────────────
MONGO_URI=mongodb://sunshop:sunshop@localhost:27017/sunshop?authSource=admin&replicaSet=rs0
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2
# Prod only: /etc/ssl/certs/global-bundle.pem (DocumentDB CA)
MONGO_TLS_CA_FILE=

# ── Redis (Amazon ElastiCache in prod) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TLS=false
REDIS_KEY_PREFIX=sunshop
REDIS_CACHE_TTL=300

# ── Elasticsearch (Amazon OpenSearch in prod) ───────────────────────────────
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=sunshop
ELASTICSEARCH_ENABLED=true

# ── Auth [SECRET] ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0000000000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-000000000000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=sunshop.api
JWT_AUDIENCE=sunshop.clients
# AES-256-GCM key for encrypting PII at rest. 32 bytes, base64. [SECRET]
FIELD_ENCRYPTION_KEY=
# Cookie settings for refresh token (web clients)
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
BCRYPT_ROUNDS=12
# Lock account after N failed logins, for M seconds
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_SECONDS=900

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_GLOBAL_POINTS=600
RATE_LIMIT_GLOBAL_DURATION=60
RATE_LIMIT_AUTH_POINTS=10
RATE_LIMIT_AUTH_DURATION=60
RATE_LIMIT_SEARCH_POINTS=60
RATE_LIMIT_SEARCH_DURATION=60
RATE_LIMIT_WRITE_POINTS=60
RATE_LIMIT_WRITE_DURATION=60

# ── Storage (Amazon S3 + CloudFront) ────────────────────────────────────────
# local | s3: local uses MinIO (S3-compatible) in docker-compose
STORAGE_DRIVER=s3
AWS_REGION=eu-central-1
S3_BUCKET=sunshop-media-dev
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
# Leave empty in EKS. IRSA provides credentials. [SECRET]
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
CDN_BASE_URL=http://localhost:9000/sunshop-media-dev
# CloudFront signed URLs for private assets (invoices). [SECRET]
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=

# ── Email ───────────────────────────────────────────────────────────────────
# smtp | ses | console
MAIL_DRIVER=smtp
MAIL_FROM="Sunshop <no-reply@sunshop.example>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── Payments (Stripe) [SECRET] ──────────────────────────────────────────────
PAYMENTS_ENABLED=true
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
DEFAULT_CURRENCY=USD
SUPPORTED_CURRENCIES=USD,EUR,EGP,SAR,AED

# ── Observability ───────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_SERVICE_NAME=sunshop-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_ENABLED=true
# Protects /metrics when scraped from outside the mesh. [SECRET]
METRICS_TOKEN=
SENTRY_DSN=

# ── Feature flags ───────────────────────────────────────────────────────────
FEATURE_REVIEWS=true
FEATURE_WISHLIST=true
FEATURE_COUPONS=true
SWAGGER_ENABLED=true

# ── Frontend (Vite) ─────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api/v1
VITE_CDN_URL=http://localhost:9000/sunshop-media-dev
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
VITE_DEFAULT_LOCALE=en
VITE_SENTRY_DSN=
