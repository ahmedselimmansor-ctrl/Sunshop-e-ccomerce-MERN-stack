# for anyone who clones the repo, CI included.
!apps/mobile/gradle/wrapper/gradle-wrapper.jar
apps/mobile/build/
apps/mobile/app/build/
apps/mobile/local.properties
apps/mobile/.idea/
apps/mobile/captures/
*.apk
*.aab
*.keystore
