# Non-secret configuration for the API.
#
# Consumed by a kustomize configMapGenerator, which appends a content hash to
# the ConfigMap name. That hash is what makes a config change actually restart
# the pods: a plain ConfigMap edit leaves running containers on the old values
# until something else happens to recreate them.
#
# Secrets live in AWS Secrets Manager and arrive via External Secrets; nothing
# in this file is sensitive.

# Core
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=info

# Proxy. Two hops sit in front of the pod (ALB, then the ingress
# controller), so Express must trust exactly two when resolving the client IP.
# Trusting all of them would let a client spoof X-Forwarded-For past rate limiting.
TRUST_PROXY_HOPS=2

# Public URLs and CORS
CORS_ORIGINS=https://sunshop.example,https://admin.sunshop.example
PUBLIC_WEB_URL=https://sunshop.example
PUBLIC_ADMIN_URL=https://admin.sunshop.example
PUBLIC_API_URL=https://api.sunshop.example

# Cookies
COOKIE_DOMAIN=.sunshop.example
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# DocumentDB
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=5
MONGO_TLS_CA_FILE=/etc/ssl/certs/global-bundle.pem

# ElastiCache
REDIS_TLS=true
REDIS_KEY_PREFIX=sunshop
REDIS_CACHE_TTL=300

# OpenSearch
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_INDEX_PREFIX=sunshop

# S3 and CloudFront
STORAGE_DRIVER=s3
AWS_REGION=eu-central-1
S3_BUCKET=sunshop-media-prod
CDN_BASE_URL=https://cdn.sunshop.example

# SES
MAIL_DRIVER=ses
MAIL_FROM=Sunshop <no-reply@sunshop.example>

# Rate limiting
RATE_LIMIT_GLOBAL_POINTS=600
RATE_LIMIT_AUTH_POINTS=10
RATE_LIMIT_SEARCH_POINTS=60
RATE_LIMIT_WRITE_POINTS=60

# Observability. The ADOT collector runs as a DaemonSet and forwards to
# X-Ray and AMP.
OTEL_ENABLED=true
OTEL_SERVICE_NAME=sunshop-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://adot-collector.observability.svc.cluster.local:4318
METRICS_ENABLED=true

# Features
SWAGGER_ENABLED=false
PAYMENTS_ENABLED=true
DEFAULT_CURRENCY=USD
